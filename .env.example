# Server
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:4000

# MongoDB (use host reachable from Docker, e.g. host IP or mongo service name)
MONGODB_URI=mongodb://127.0.0.1:27017/your_db_name

# Auth
JWT_SECRET=change_me

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Meta Conversions API (server-side; never expose the access token in frontend code)
META_PIXEL_IDS=1609839080107013,860862546423818
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_2=
META_GRAPH_API_VERSION=v20.0

# SMTP (OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional
PING_NAME=
PING_AGE=
SHOP_CATEGORIES_PRIMARY_IDS=
